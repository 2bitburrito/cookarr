# SQLite is the default; no database service is required.
DB_DRIVER=sqlite
DB=data/cookarr.db

# To use an existing Postgres database instead:
# DB_DRIVER=postgres
# DATABASE_URL=postgres://cookarr:change-me@localhost:5432/cookarr?sslmode=verify-full
# Use sslmode=disable only for a trusted local development database.
# Cookarr reads environment variables; this file is not loaded automatically.

# Integration tests create and drop isolated schemas in this database.
# TEST_POSTGRES_URL=postgres://cookarr:change-me@localhost:5432/cookarr_test?sslmode=disable
